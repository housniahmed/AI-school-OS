DATABASE_URL=postgresql://schoolos:schoolos@localhost:5432/schoolos
REDIS_URL=redis://localhost:6379
PORT=4000
TRUST_PROXY=1
CORS_ORIGIN=http://localhost:5173
# Local development only. Production secrets must be injected by an external secret manager.
JWT_SECRET=change-me-with-at-least-32-characters-for-local-use
SECRETS_PROVIDER=env
SECRETS_NAMESPACE=ai-school-os/local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AI_MAX_TOOL_CALLS=4
NODE_ENV=development
