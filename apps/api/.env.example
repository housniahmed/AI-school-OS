DATABASE_URL=postgresql://schoolos:schoolos@localhost:5432/schoolos
REDIS_URL=redis://localhost:6379
PORT=4000
TRUST_PROXY=1
CORS_ORIGIN=http://localhost:5173
# Local development only. Production secrets must be injected by an external secret manager.
JWT_SECRET=change-me-with-at-least-32-characters-for-local-use
SECRETS_PROVIDER=env
SECRETS_NAMESPACE=ai-school-os/local
OPENAI_API_KEY=
# Production: set true only after the customer-specific external AI/data-transfer review is approved.
EXTERNAL_AI_PROCESSING_ACK=false
# Required in production; inject from the external secret manager. Never commit a real value.
METRICS_TOKEN=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AI_MAX_TOOL_CALLS=4
NODE_ENV=development

# OpenTelemetry: disabled locally by default; enable OTLP explicitly in deployed environments.
OTEL_SERVICE_NAME=ai-school-os-api
OTEL_TRACES_EXPORTER=none
OTEL_PROPAGATORS=tracecontext
OTEL_NODE_RESOURCE_DETECTORS=none
OTEL_LOG_LEVEL=none
# Comma-separated hostnames that are trusted internal services for outbound trace propagation.
OTEL_TRACE_OUTBOUND_HOSTS=
# When OTEL_TRACES_EXPORTER=otlp, configure the collector endpoint via OTEL_EXPORTER_OTLP_ENDPOINT
# and credentials via OTEL_EXPORTER_OTLP_HEADERS or the signal-specific equivalent. Never commit them.
