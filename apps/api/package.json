{
  "name": "ai-school-os-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --import ./src/instrumentation.ts watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --import ./dist/src/instrumentation.js dist/src/index.js",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:validate": "prisma validate",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.222.0",
    "@opentelemetry/instrumentation-http": "^0.222.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@prisma/client": "^6.15.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^4.1.0",
    "qrcode": "^1.5.4",
    "express-rate-limit": "^8.7.0",
    "rate-limit-redis": "^6.0.1",
    "redis": "^6.2.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.3.0",
    "@types/qrcode": "^1.5.5",
    "prisma": "^6.15.0",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2"
  },
  "version": "0.6.0"
}
